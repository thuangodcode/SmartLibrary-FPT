# ============================================================
# SmartLibrary – .gitignore
# ============================================================

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# ── IDE ──
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/

# ── .NET ──
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json
appsettings.*.json
!appsettings.json

# User Secrets
secrets.json

# ── Node / Web / Mobile ──
node_modules/
dist/
.next/
.cache/
*.tsbuildinfo

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Environment ──
.env
.env.local
.env.*.local
!.env.example

# ── Supabase ──
supabase/.temp/
supabase/.branches/

# ── Docker ──
docker-compose.override.yml

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Coverage ──
coverage/
*.lcov
TestResults/

# ── Build artifacts ──
*.dll
*.exe
*.pdb

# ── AI Agents & Local configs ──
.agents/
.cursor/
.codacy/

# Local working notes and handoff (kept on disk, not published)
/project_understanding.md
/docs/category-book-codes.md
/docs/circulation-policy-clarity.md
/docs/librarian-flow-audit.md
/docs/mobile-librarian-phase1.md
/docs/mobile-librarian-phase2.md
/docs/mobile-librarian-ui-refresh.md
