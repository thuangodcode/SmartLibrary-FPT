{
  "name": "smartlibrary-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "dotnet run --project apps/api/src/SmartLibrary.Api --urls http://localhost:5278",
    "build:api": "dotnet build apps/api/SmartLibrary.slnx",
    "test:api": "dotnet test apps/api/SmartLibrary.slnx",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
