{
  "name": "smartlibrary-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:lan": "node scripts/dev-api.mjs --lan",
    "dev:api:stop": "node scripts/dev-api.mjs --stop",
    "build:api": "dotnet build apps/api/SmartLibrary.slnx",
    "test:api": "dotnet test apps/api/SmartLibrary.slnx",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build:mobile": "npm --prefix apps/mobile run typecheck",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:lan": "concurrently \"npm run dev:api:lan\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "demo:seed": "dotnet run --project tools/SmartLibrary.Demo -- .env",
    "demo:repair-auth": "dotnet run --project tools/SmartLibrary.Demo -- .env --repair-auth",
    "demo:align": "dotnet run --project tools/SmartLibrary.Demo -- .env --align-workflow",
    "demo:overdue": "dotnet run --project tools/SmartLibrary.Demo -- .env --overdue",
    "demo:prepare-tests": "dotnet run --project tools/SmartLibrary.Demo -- --prepare-tests",
    "demo:test-status": "dotnet run --project tools/SmartLibrary.Demo -- --test-status",
    "demo:test-overdue": "dotnet run --project tools/SmartLibrary.Demo -- --test-overdue"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
