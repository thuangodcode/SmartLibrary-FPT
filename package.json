{
  "name": "smartlibrary-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:lan": "node scripts/dev-api.mjs --lan",
    "dev:api:stop": "node scripts/dev-api.mjs --stop",
    "build:api": "dotnet build apps/api/SmartLibrary.slnx",
    "test:api": "dotnet test apps/api/SmartLibrary.slnx",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build:mobile": "npm --prefix apps/mobile run typecheck",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:lan": "concurrently \"npm run dev:api:lan\" \"npm run dev:web\" \"npm run dev:mobile\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
