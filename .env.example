# SmartLibrary Environment Configuration Sample
# Copy to .env and fill real values. Do NOT commit .env

# Postgres via Supabase Session Pooler (IPv4) — recommended for local Windows
# Dashboard → Project Settings → Database → Connection string → Session pooler
ConnectionStrings__DefaultConnection=Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true

# Supabase API
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__AnonKey=your-anon-key
Supabase__ServiceRoleKey=your-service-role-key

Jwt__Issuer=https://YOUR_PROJECT_REF.supabase.co/auth/v1
Jwt__Audience=authenticated
Jwt__Secret=your-supabase-jwt-secret-at-least-32-characters-long

# Email delivery (Resend is preferred; SMTP is the fallback)
Resend__ApiKey=your-resend-api-key
Resend__From=SmartLibrary <onboarding@resend.dev>
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-sender@gmail.com
Smtp__Password=your-new-google-app-password
Smtp__FromAddress=your-sender@gmail.com
Smtp__FromName=SmartLibrary
Smtp__EnableSsl=true

# Cloudinary (optional file storage)
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-cloudinary-api-key
Cloudinary__ApiSecret=your-cloudinary-api-secret

# PayOS sandbox/production credentials (never commit real values)
# Register this public webhook URL in PayOS: https://<api-host>/api/v1/payments/payos/webhook
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__ReturnUrl=https://smart-library-fpt.vercel.app/history
PayOS__CancelUrl=https://smart-library-fpt.vercel.app/history

# AI / RAG (API Key Gemini do Admin lưu trên UI; khoá mã hoá bằng Ai__EncryptionKey)
Ai__EncryptionKey=replace-with-a-long-random-string
Ai__ChatModel=gemini-2.0-flash
Ai__EmbeddingModel=text-embedding-004
# Optional cache directory for the quantized local ONNX embedding model (~123 MB).
Ai__LocalEmbeddingModelDirectory=

# Frontend (also set apps/web/.env.local)
API_URL=http://localhost:5278
VITE_API_URL=http://localhost:5278
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_USE_AI_EDGE=false
