{
  "expo": {
    "name": "SmartLibrary",
    "slug": "smartlibrary-fpt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "smartlibrary",
    "splash": {
      "backgroundColor": "#f4f7f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.smartlibrary.app"
    },
    "android": {
      "package": "vn.smartlibrary.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#f4f7f2"
      }
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
